# Endpoints for the acquisition workflow only. Never committed with credentials,
# and never needed by the CI path: `eplyx ci check` and the hosted server read a
# bundle and execute offline, so an RPC credential has no business near either.
#
# Nothing loads this file automatically. Export it yourself:
#
#   set -a && . ./.env && set +a

# Transaction history: blocks, transactions, signatures. A standard archival
# endpoint is enough.
SOLANA_RPC_URL=http://127.0.0.1:18899

# Slot-addressable account state: `getAccountInfo` honouring an exact `slot`.
# This is the uncommon one, and the one Eplyx cannot reconstruct — see
# docs/phase-7-production-protocol-upgrade.md. Falls back to SOLANA_RPC_URL,
# which will fail loudly rather than quietly returning today's state.
# Prove an endpoint before trusting it: scripts/probe-archive.sh <url>
#SOLANA_ARCHIVE_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY

# Block source for same-slot interference screening. Falls back to
# SOLANA_RPC_URL. A block is megabytes of response, so a separate endpoint is
# worth naming when the transaction endpoint is metered differently.
#SOLANA_BLOCK_RPC_URL=
